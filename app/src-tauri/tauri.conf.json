{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wisp",
  "mainBinaryName": "Wisp",
  "version": "0.1.0",
  "identifier": "com.wisp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Wisp",
        "width": 1040,
        "height": 740,
        "minWidth": 820,
        "minHeight": 640,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "windows": {
      "minimumWebview2Version": "120.0.2210.61"
    },
    "resources": [
      "resources/silero_vad.onnx"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "frameworks": [
        "target/release/libonnxruntime.1.17.1.dylib",
        "target/release/libsherpa-onnx-c-api.dylib"
      ]
    }
  }
}
